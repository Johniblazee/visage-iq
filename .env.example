# Postgres
DATABASE_URL=postgresql://postgres:pg@db:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Google Drive
GDRIVE_SA_JSON_PATH=/run/secrets/gdrive-sa
GDRIVE_FOLDER_ID=replace-with-folder-id
GDRIVE_RECURSIVE=true

# InsightFace
INSIGHTFACE_MODEL=buffalo_l
DET_SIZE=640
ONNX_PROVIDERS=CPUExecutionProvider

# Match thresholds + top-K
MATCH_THRESHOLD=0.40
REVIEW_THRESHOLD=0.30
TOP_K=3

# Sync
SYNC_INTERVAL_MIN=30
SYNC_BATCH_COMMIT=50

# Cache
IMAGE_CACHE_TTL_SECONDS=86400
LISTING_CACHE_TTL_SECONDS=300

# Rate limit (per IP)
MATCH_RATE_LIMIT=30/minute
SYNC_RATE_LIMIT=5/minute

# UI
API_BASE_URL=http://api:8000
