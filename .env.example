# --------------------------------------------------------------------------
# Performance tuning — CPU vs GPU recommended values
# --------------------------------------------------------------------------
# Sync embeds ONE file at a time (single-throughput — stable on GPU; the
# ProcessPool/multi-thread design destabilised onnxruntime-gpu, signal 6/11).
# Lever                       CPU            GPU
# ONNX_PROVIDERS              CPUExecution.. CUDAExecution..,CPUExecution..
# DET_SIZE                    640            640
# ROTATION_MODE               fallback       fallback
# SYNC_BATCH_COMMIT           50             200
# SYNC_PREFETCH               true           true (once E2E shows it stays
#                                            crash-free; else false) — overlaps
#                                            Drive I/O with embed, 1 thread
# INSIGHTFACE_MODULES         detection,recognition (both modes)
# WORKER_REPLICAS             1              1
# SYNC_ONNX_PROVIDERS         blank          CPUExecutionProvider if GPU
#                                            sync crashes (signal 6/11)
# --------------------------------------------------------------------------

# Postgres
DATABASE_URL=postgresql://postgres:pg@db:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Google Drive
# GDRIVE_SA_JSON: paste the FULL contents of your service-account JSON key.
#   - Easiest: keep on one line, wrapped in single quotes:
#       GDRIVE_SA_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...",...}'
#   - Or multiline between single quotes (python-dotenv supports it):
#       GDRIVE_SA_JSON='{
#         "type": "service_account",
#         ...
#       }'
#   - To flatten a downloaded JSON to one line:
#       cat path/to/key.json | python -c "import json,sys; print(json.dumps(json.load(sys.stdin)))"
GDRIVE_SA_JSON=
GDRIVE_FOLDER_ID=replace-with-folder-id
GDRIVE_RECURSIVE=true

# InsightFace
INSIGHTFACE_MODEL=buffalo_l
DET_SIZE=640
ONNX_PROVIDERS=CPUExecutionProvider
# Comma-separated list of InsightFace sub-modules to load. The defaults skip
# genderage / landmark_2d_106 / landmark_3d_68 — saves ~30–40% RAM on the
# worker. Set to "" (empty) or list all five to restore the full loadout.
INSIGHTFACE_MODULES=detection,recognition
# Optional sync-only overrides for faster bulk enrollment. Leave blank to reuse
# the interactive /match settings above.
SYNC_INSIGHTFACE_MODEL=
SYNC_DET_SIZE=
SYNC_INSIGHTFACE_MODULES=
# Sync-only ONNX providers. Blank = reuse ONNX_PROVIDERS. The escape hatch
# when the GPU stack (onnxruntime-gpu/CUDA) crashes the worker mid-sync with
# a native abort (signal 6/11, "double free or corruption"): set this to
# CPUExecutionProvider so ingestion runs stably on CPU while /match keeps
# using the GPU. Slower (~1.5 s/file) but crash-free.
#   SYNC_ONNX_PROVIDERS=CPUExecutionProvider
SYNC_ONNX_PROVIDERS=

# Sync embeds ONE file at a time (single-throughput — stable on GPU).
# When true, a single background thread pre-fetches the next file's bytes
# while the current file is embedding, overlapping Drive download (~200–800
# ms) with embed (~50–150 ms on GPU) — up to ~2x when download-bound. One
# thread, one inflight item. Default false; flip true once the E2E run shows
# it stays crash-free on your GPU (see docs/HOWTO.md).
SYNC_PREFETCH=false
# Rotation handling — three-mode knob:
#   off      — only ever try 0°. Fastest. A tilted photo that doesn't detect
#              at 0° gets skipped as no_face.
#   fallback — try 0° first; if a face is found, use it. Only try 90/180/270
#              when 0° found NO face. Recommended default — zero extra cost
#              for upright photos, recovers genuinely rotated ones.
#   always   — iterate all four rotations and pick the one with the highest
#              detector score. Most robust but most expensive (~4× detector
#              calls per file in the worst case; see ROTATION_EARLY_EXIT_SCORE
#              for the short-circuit knob).
ROTATION_MODE=fallback

# Kill-switch: if false, forces ROTATION_MODE=off regardless of the value above.
ROTATION_ENABLED=true

# Used only when ROTATION_MODE=always: short-circuit the loop once a rotation
# produces at least this detector score. Set to 1.0 to always try all four.
ROTATION_EARLY_EXIT_SCORE=0.85
SYNC_ROTATION_ENABLED=
SYNC_ROTATION_MODE=
SYNC_ROTATION_EARLY_EXIT_SCORE=

# Match thresholds + top-K
MATCH_THRESHOLD=0.8
REVIEW_THRESHOLD=0.70
TOP_K=3

# Sync
SYNC_INTERVAL_MIN=30
SYNC_BATCH_COMMIT=50

# Worker container scaling (read by the Makefile when running `make up`/`make rebuild`).
# Each worker holds its own ~500 MB InsightFace instance in RAM; a GPU instance also reserves the same GPU.
# NOTE: a single sync job is held by one worker (Redis lock prevents concurrent syncs of the same folder),
# so >1 worker doesn't speed up *one* sync — it helps when multiple sync jobs land at once or for future
# per-file fan-out work.
WORKER_REPLICAS=1

# Cache
IMAGE_CACHE_TTL_SECONDS=86400

# Rate limit (per IP)
MATCH_RATE_LIMIT=30/minute
SYNC_RATE_LIMIT=5/minute

# UI
API_BASE_URL=http://api:8000
