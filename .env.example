# Postgres
DATABASE_URL=postgresql://postgres:pg@db:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# Google Drive
# GDRIVE_SA_JSON: paste the FULL contents of your service-account JSON key.
#   - Easiest: keep on one line, wrapped in single quotes:
#       GDRIVE_SA_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...",...}'
#   - Or multiline between single quotes (python-dotenv supports it):
#       GDRIVE_SA_JSON='{
#         "type": "service_account",
#         ...
#       }'
#   - To flatten a downloaded JSON to one line:
#       cat path/to/key.json | python -c "import json,sys; print(json.dumps(json.load(sys.stdin)))"
GDRIVE_SA_JSON=
GDRIVE_FOLDER_ID=replace-with-folder-id
GDRIVE_RECURSIVE=true

# InsightFace
INSIGHTFACE_MODEL=buffalo_l
DET_SIZE=640
ONNX_PROVIDERS=CPUExecutionProvider
# Rotation handling — three-mode knob:
#   off      — only ever try 0°. Fastest. A tilted photo that doesn't detect
#              at 0° gets skipped as no_face.
#   fallback — try 0° first; if a face is found, use it. Only try 90/180/270
#              when 0° found NO face. Recommended default — zero extra cost
#              for upright photos, recovers genuinely rotated ones.
#   always   — iterate all four rotations and pick the one with the highest
#              detector score. Most robust but most expensive (~4× detector
#              calls per file in the worst case; see ROTATION_EARLY_EXIT_SCORE
#              for the short-circuit knob).
ROTATION_MODE=fallback

# Kill-switch: if false, forces ROTATION_MODE=off regardless of the value above.
ROTATION_ENABLED=true

# Used only when ROTATION_MODE=always: short-circuit the loop once a rotation
# produces at least this detector score. Set to 1.0 to always try all four.
ROTATION_EARLY_EXIT_SCORE=0.85

# Match thresholds + top-K
MATCH_THRESHOLD=0.8
REVIEW_THRESHOLD=0.70
TOP_K=3

# Sync
SYNC_INTERVAL_MIN=30
SYNC_BATCH_COMMIT=50

# Worker container scaling (read by the Makefile when running `make up`/`make rebuild`).
# Each worker holds its own ~500 MB InsightFace instance in RAM; a GPU instance also reserves the same GPU.
# NOTE: a single sync job is held by one worker (Redis lock prevents concurrent syncs of the same folder),
# so >1 worker doesn't speed up *one* sync — it helps when multiple sync jobs land at once or for future
# per-file fan-out work.
WORKER_REPLICAS=1

# Cache
IMAGE_CACHE_TTL_SECONDS=86400
LISTING_CACHE_TTL_SECONDS=300

# Rate limit (per IP)
MATCH_RATE_LIMIT=30/minute
SYNC_RATE_LIMIT=5/minute

# UI
API_BASE_URL=http://api:8000
